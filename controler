print(f"Control force range: {FPI4_m5.min():.1f} ... {FPI4_m5.max():.1f} N")

fig5, ax5 = plt.subplots(figsize=(11, 5))
ax5.plot(t4, vref4*3.6, color="tab:blue", lw=1, label="Reference")
