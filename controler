import numpy as np
import matplotlib.pyplot as plt

# ============================================================
# EV SPEED CONTROL – TASK 4.5 VALIDATION & FINAL CHECKLIST
# 1) Constant force
# 2) Constant speed: P vs PI
# 3) Acceleration/braking ramps
# 4) Full NEDC
# 5) Additional test: vehicle mass +5%
# 6) Final checklist
# ============================================================
m = 1600.0
rho, Cd, A, Crr, g = 1.225, 0.29, 2.20, 0.012, 9.81
theta = 0.0
Fmax, Fmin, dt = 5000.0, -4000.0, 0.02
Ts, zeta = 4.0, 1.0

# Gains designed from the plant G(s) = 1/(m*s) only
Kp_P = 4*m/Ts
wn = 4/(zeta*Ts)
Kp_PI = 2*zeta*wn*m
Ki_PI = m*wn**2

print("="*60)
print("CONTROLLER DESIGN")
print("="*60)
print(f"{'Controller':<10}{'Gain':<6}{'Value'}")
print(f"{'P':<10}{'Kp':<6}{Kp_P:.0f} N·s/m")
print(f"{'PI':<10}{'Kp':<6}{Kp_PI:.0f} N·s/m")
print(f"{'PI':<10}{'Ki':<6}{Ki_PI:.0f} N/m")


def resistance(v, theta=0.0, mass=m):
    return 0.5*rho*Cd*A*v**2 + Crr*mass*g*np.cos(theta) + mass*g*np.sin(theta)


def run(vref, controller="PI", mass=m, apply_resistance=True):
    """Simulate vehicle speed tracking with a P or PI controller.
    apply_resistance=False disables the resistance term in the physics update
    (used only for the clean Task 1 F=const validation)."""
    vref = np.asarray(vref, float)
    t = np.arange(len(vref))*dt
    v = np.zeros_like(vref)
    e = np.zeros_like(vref)
    F = np.zeros_like(vref)
    z = 0.0
    for k in range(len(vref)-1):
        e[k] = vref[k]-v[k]                     # negative feedback: e = vref - v
        if controller == "P":
            cmd = Kp_P*e[k]
        else:
            cmd = Kp_PI*e[k] + Ki_PI*z
        F[k] = np.clip(cmd, Fmin, Fmax)          # traction/braking force limits
        # Conditional-integration anti-windup
        if controller == "PI":
            high = cmd > Fmax
            low = cmd < Fmin
            if ((not high and not low) or
                (high and e[k] < 0) or
                (low and e[k] > 0)):
                z += dt*e[k]
        res = resistance(v[k], theta, mass) if apply_resistance else 0.0
        a = (F[k]-res)/mass
        v[k+1] = max(0.0, v[k] + dt*a)           # speed cannot be negative
    e[-1] = vref[-1]-v[-1]
    F[-1] = F[-2] if len(F) > 1 else 0
    return t, v, e, F


def metrics(vref, v, e):
    moving = v > 0.1
    dref = np.gradient(vref, dt)
    plateau = (np.abs(dref) < 1e-10) & moving
    return {
        "RMS error (km/h)": np.sqrt(np.mean((e*3.6)**2)),
        "MAE while moving (km/h)": np.mean(np.abs(e[moving]*3.6)),
        "Maximum |error| (km/h)": np.max(np.abs(e*3.6)),
        "MAE settled plateaus (km/h)": np.mean(np.abs(e[plateau]*3.6)),
    }


# ---------------- Task 1 : Constant force through the controller / Newton's law check ----------------
# Purpose: drive the vehicle through the actual P-controller run() function, but
# choose the reference vref(t) so that the tracking error stays exactly
# e = F_test / Kp_P at every step. That forces the controller's own output
# cmd = Kp_P * e to equal a constant F_test = 1600 N throughout - the force is
# genuinely produced BY the controller, not injected from outside.
# Resistance is disabled for this test so the result is a clean a = F/m check.
F_test = 1600.0
a_expected = F_test/m
e_needed = F_test/Kp_P              # error that makes Kp_P*e equal F_test exactly

t1 = np.arange(0, 20+dt, dt)
vref1 = e_needed + a_expected*t1    # reference ramp: keeps e(t) = e_needed at all times
_, v1, e1, F1 = run(vref1, "P", apply_resistance=False)

a_sim = np.gradient(v1, dt)
max_diff_a = np.max(np.abs(a_sim - a_expected))
max_diff_F = np.max(np.abs(F1[:-1] - F_test))

print("\n" + "="*60)
print("TASK 1 – CONSTANT FORCE THROUGH THE CONTROLLER")
print("="*60)
print("The reference vref(t) is shaped so the P controller's own error stays at "
      f"e = F_test/Kp_P = {e_needed:.3f} m/s, so its output cmd = Kp_P*e is a "
      f"genuine, controller-generated constant force.")
print(f"Controller force stays within {max_diff_F:.2e} N of F_test = {F_test:.0f} N.")
print(f"With F = {F_test:.0f} N and m = {m:.0f} kg, Newton's law gives "
      f"a = F/m = {a_expected:.3f} m/s².")
print(f"Simulated acceleration differs by at most {max_diff_a:.2e} m/s².")
print("Result confirms the controller correctly produces the commanded force "
      "and the vehicle obeys the basic equation of motion.")

fig1, ax1 = plt.subplots(figsize=(9, 6))
ax1.plot(t1, a_sim, color="tab:blue", lw=2, label="Simulated")
ax1.axhline(a_expected, color="tab:blue", ls="--", lw=2, label="Newton F/m")
ax1.set_xlabel("Time (s)")
ax1.set_ylabel("Acceleration (m/s²)")
ax1.set_title("Task 1 – Constant Force / Newton Law")
ax1.set_ylim(a_expected-1, a_expected+1)
ax1.legend()
ax1.grid(alpha=0.3)
fig1.tight_layout()
fig1.savefig("task1_constant_force.png", dpi=150)

# ---------------- Task 2 : Constant speed request ----------------
t2 = np.arange(0, 30+dt, dt)
vref2 = np.full_like(t2, 50.0/3.6)
_, vP2, eP2, FP2 = run(vref2, "P")
_, vPI2, ePI2, FPI2 = run(vref2, "PI")
last = t2 >= 25
ss_P = np.mean(eP2[last]*3.6)
ss_PI = np.mean(ePI2[last]*3.6)

print("\n" + "="*60)
print("TASK 2 – CONSTANT SPEED REQUEST")
print("="*60)
print(f"P steady-state error (last 5 s)  = {ss_P:.3f} km/h")
print(f"PI steady-state error (last 5 s) = {ss_PI:.3f} km/h")
print("P keeps an offset because it needs a positive error to produce the "
      "force that balances resistance. PI accumulates error and builds the "
      "force needed to remove the offset.")

fig2a, ax2a = plt.subplots(figsize=(9, 5.5))
ax2a.plot(t2, vref2*3.6, color="tab:blue", label="Reference")
ax2a.plot(t2, vP2*3.6, color="tab:orange", label="P")
ax2a.plot(t2, vPI2*3.6, color="tab:green", label="PI")
ax2a.set_xlabel("Time (s)")
ax2a.set_ylabel("Speed (km/h)")
ax2a.set_title("Task 2 – Constant Speed: P vs PI")
ax2a.legend()
ax2a.grid(alpha=0.3)
fig2a.tight_layout()
fig2a.savefig("task2_constant_speed.png", dpi=150)

fig2b, ax2b = plt.subplots(figsize=(9, 5.5))
ax2b.plot(t2, eP2*3.6, color="tab:blue", label="P error")
ax2b.plot(t2, ePI2*3.6, color="tab:orange", label="PI error")
ax2b.set_xlabel("Time (s)")
ax2b.set_ylabel("Error (km/h)")
ax2b.set_title("Task 2 – Constant Speed Error")
ax2b.legend()
ax2b.grid(alpha=0.3)
fig2b.tight_layout()
fig2b.savefig("task2_constant_speed_error.png", dpi=150)

# ---------------- Task 3 : Acceleration and braking ramps ----------------
t3 = np.arange(0, 40+dt, dt)
vref3 = np.piecewise(
    t3,
    [t3 < 10, (t3 >= 10) & (t3 < 20), (t3 >= 20) & (t3 < 30), t3 >= 30],
    [lambda x: 5*x, lambda x: 50,
     lambda x: 50-5*(x-20), lambda x: 0]
)/3.6
_, v3, e3, F3 = run(vref3, "PI")
accel_mask = t3 < 10
brake_mask = (t3 >= 20) & (t3 < 30)

print("\n" + "="*60)
print("TASK 3 – ACCELERATION AND BRAKING RAMPS")
print("="*60)
print(f"Acceleration ramp force range: {F3[accel_mask].min():.1f} ... {F3[accel_mask].max():.1f} N")
print(f"Braking ramp force range:      {F3[brake_mask].min():.1f} ... {F3[brake_mask].max():.1f} N")
print(f"Overall force range:           {F3.min():.1f} ... {F3.max():.1f} N")
print(f"Within [{Fmin:.0f}, {Fmax:.0f}] N:      {F3.min()>=Fmin and F3.max()<=Fmax}")
print("Positive force is used to accelerate, negative force to brake.")

fig3a, ax3a = plt.subplots(figsize=(9, 5.5))
ax3a.plot(t3, vref3*3.6, color="tab:blue", label="Reference")
ax3a.plot(t3, v3*3.6, color="tab:orange", label="PI")
ax3a.set_xlabel("Time (s)")
ax3a.set_ylabel("Speed (km/h)")
ax3a.set_title("Task 3 – Acceleration and Braking Ramps")
ax3a.legend()
ax3a.grid(alpha=0.3)
fig3a.tight_layout()
fig3a.savefig("task3_ramps.png", dpi=150)

fig3b, ax3b = plt.subplots(figsize=(9, 5.5))
ax3b.plot(t3, F3, color="tab:blue", label="Requested force")
ax3b.axhline(Fmax, color="tab:blue", ls="--", label="Fmax")
ax3b.axhline(Fmin, color="tab:blue", ls="--", label="Fmin")
ax3b.set_xlabel("Time (s)")
ax3b.set_ylabel("Force (N)")
ax3b.set_title("Task 3 – Force Sign and Limits")
ax3b.legend()
ax3b.grid(alpha=0.3)
fig3b.tight_layout()
fig3b.savefig("task3_force_limits.png", dpi=150)

# ---------------- Task 4 : Full NEDC ----------------
urban = np.array([
    [0, 0], [11, 0], [4, 15], [8, 15], [5, 0], [21, 0], [6, 15], [6, 32],
    [24, 32], [11, 0], [21, 0], [6, 15], [11, 35], [9, 50], [12, 50],
    [8, 35], [15, 35], [10, 0], [7, 0]
], float)
eudc = np.array([
    [0, 0], [20, 0], [6, 15], [11, 35], [10, 50], [14, 70], [50, 70],
    [8, 50], [69, 50], [13, 70], [50, 70], [35, 100], [30, 100], [20, 120],
    [10, 120], [16, 80], [8, 50], [10, 0], [20, 0]
], float)
segments = np.vstack([urban]*4+[eudc])
tp = np.cumsum(segments[:, 0])
sp = segments[:, 1]
t4 = np.arange(0, 1180+1e-12, dt)
vref4 = np.interp(t4, tp, sp)/3.6
_, vP4, eP4, FP4 = run(vref4, "P")
_, vPI4, ePI4, FPI4 = run(vref4, "PI")
MP = metrics(vref4, vP4, eP4)
MPI = metrics(vref4, vPI4, ePI4)

print("\n" + "="*60)
print("TASK 4 – FULL NEDC")
print("="*60)
print("NEDC simulated over 1180 s: four 195 s urban cycles + one 400 s extra-urban cycle.")
print(f"{'Metric':<32}{'P':<10}{'PI'}")
for k in MP:
    print(f"{k:<32}{MP[k]:<10.3f}{MPI[k]:.3f}")
print(f"PI requested force range: {FPI4.min()/1000:.3f} ... {FPI4.max()/1000:.3f} kN")

fig4a, ax4a = plt.subplots(figsize=(11, 5))
ax4a.plot(t4, vref4*3.6, color="tab:blue", lw=1, label="Reference")
ax4a.plot(t4, vP4*3.6, color="tab:orange", alpha=0.9, label="P")
ax4a.plot(t4, vPI4*3.6, color="tab:green", alpha=0.9, label="PI")
ax4a.set_xlabel("Time (s)")
ax4a.set_ylabel("Speed (km/h)")
ax4a.set_title("Task 4 – Full NEDC Speed Tracking")
ax4a.legend()
ax4a.grid(alpha=0.3)
fig4a.tight_layout()
fig4a.savefig("task4_nedc_speed.png", dpi=150)

fig4b, ax4b = plt.subplots(figsize=(11, 5))
ax4b.plot(t4, eP4*3.6, color="tab:blue", alpha=0.9, label="P error")
ax4b.plot(t4, ePI4*3.6, color="tab:orange", alpha=0.9, label="PI error")
ax4b.set_xlabel("Time (s)")
ax4b.set_ylabel("Error (km/h)")
ax4b.set_title("Task 4 – Full NEDC Tracking Error")
ax4b.legend()
ax4b.grid(alpha=0.3)
fig4b.tight_layout()
fig4b.savefig("task4_nedc_error.png", dpi=150)

fig4c, ax4c = plt.subplots(figsize=(11, 5))
ax4c.plot(t4, FP4, color="tab:blue", alpha=0.8, label="P force")
ax4c.plot(t4, FPI4, color="tab:orange", alpha=0.8, label="PI force")
ax4c.axhline(Fmax, color="tab:blue", ls="--", label="Fmax")
ax4c.axhline(Fmin, color="tab:blue", ls="--", label="Fmin")
ax4c.set_xlabel("Time (s)")
ax4c.set_ylabel("Force (N)")
ax4c.set_title("Task 4 – Requested Force")
ax4c.legend()
ax4c.grid(alpha=0.3)
fig4c.tight_layout()
fig4c.savefig("task4_nedc_force.png", dpi=150)

# ---------------- Discussion ----------------
print("\n" + "="*60)
print("DISCUSSION – P OFFSET, PI, SATURATION AND ANTI-WINDUP")
print("="*60)
print("The P controller has a steady-state offset because Ft = Kp*e; if e = 0 "
      "the controller produces no force, while the vehicle still needs force to "
      "overcome drag and rolling resistance. PI fixes this with integral action. "
      "Force saturation protects the traction/braking limits. When PI saturates, "
      "anti-windup stops the integral from growing further in the direction that "
      "deepens saturation.")

# ---------------- Additional test : vehicle mass +5% ----------------
m_plus5 = m*1.05
_, vPI4_m5, ePI4_m5, FPI4_m5 = run(vref4, "PI", mass=m_plus5)
M_m5 = metrics(vref4, vPI4_m5, ePI4_m5)

print("\n" + "="*60)
print("ADDITIONAL TEST – VEHICLE MASS +5%")
print("="*60)
print(f"Same PI gains, mass increased from {m:.0f} kg to {m_plus5:.0f} kg.")
for k in M_m5:
