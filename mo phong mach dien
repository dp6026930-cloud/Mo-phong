#  TASK 3: MACH BUCK DON GIAN (Nguon - K - L - C // Tai)
# =====================================================================
def simulate_buck(Vin=220.0, L=330e-6, C=47e-6, R_tai=5.0,
                  Ron=0.05, Vd=0.7, fsw=50e3, Ton=0.52e-6,
                  dt=10e-9, t_end=10e-3):
    """
    Mo phong mach buck ho vong bang Euler tien.
    Tra ve: t, iL, vC, vsw, thong_tin (dict)
    """
    T = 1 / fsw
    D = Ton / T
    N = int(t_end / dt)
    # Dem buoc nguyen de xung K khong bi lech do sai so lam tron so thuc
    buoc_T = round(T / dt)
    buoc_on = round(Ton / dt)

    t = np.arange(N) * dt
    iL = np.zeros(N)
    vC = np.zeros(N)
    vsw = np.zeros(N)

    i, v = 0.0, 0.0      # dieu kien dau: iL = 0, vC = 0
    for n in range(N):
        k = n % buoc_T
        dong = k < buoc_on
        if dong:                     # K dong
            u = Vin - Ron * i
        elif i > 0:                  # K mo, diode dan
            u = -Vd
        else:                        # K mo, iL = 0 (DCM)
            u = v
        di_dt = (u - v) / L
        dv_dt = (i - v / R_tai) / C
        i += dt * di_dt
        v += dt * dv_dt
        if (not dong) and i < 0:     # diode khong cho dong am
            i = 0.0
        iL[n], vC[n], vsw[n] = i, v, u

    ss = t > t_end - 2e-3            # 2 ms cuoi (da on dinh)
    thong_tin = {
        "loai_mach": "Buck",
        "D": D,
        "Vout_tb": vC[ss].mean(),
        "gonsong_V": vC[ss].max() - vC[ss].min(),
        "IL_tb": iL[ss].mean(),
        "gonsong_I": iL[ss].max() - iL[ss].min(),
        "vot_lo": vC.max(),
        "t_end": t_end,
    }
    return t, iL, vC, vsw, thong_tin


