#  TASK 2 - CACH B: DAO HAM 2 VE + SAI PHAN BAC 2

def simulate_rlc_bac2(V0, R, L, C, t_end=None, n_points=3000):
    alpha = R / (2 * L)
    omega0 = 1 / np.sqrt(L * C)
    if t_end is None:
        t_end = 5 / alpha if alpha > 0 else 20 / omega0

    t = np.linspace(0, t_end, n_points)
    dt = t[1] - t[0]

    i = np.zeros(n_points)
    di0 = V0 / L
    d2i0 = -R * V0 / L**2
    i[0] = 0.0
    i[1] = i[0] + dt * di0 + 0.5 * dt**2 * d2i0

    a = L / dt**2
    b = R / (2 * dt)
    for n in range(1, n_points - 1):
        i[n + 1] = ((2 * a - 1 / C) * i[n] - (a - b) * i[n - 1]) / (a + b)

    
    didt = np.zeros(n_points)
    didt[1:-1] = (i[2:] - i[:-2]) / (2 * dt)
    didt[0] = di0
    didt[-1] = (i[-1] - i[-2]) / dt

    V_R = R * i
    V_L = L * didt
    V_C = V0 - V_R - V_L
    return t, i, {"U_R": V_R, "U_L": V_L, "U_C": V_C, "dt": dt}

