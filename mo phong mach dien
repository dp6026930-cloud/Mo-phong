def nghiem_giai_tich_rlc(t, V0, R, L, C):
    alpha = R / (2 * L)
    w0 = 1 / np.sqrt(L * C)
    wd = np.sqrt(w0**2 - alpha**2)
    i = V0 / (wd * L) * np.exp(-alpha * t) * np.sin(wd * t)
    U_C = V0 * (1 - np.exp(-alpha * t) * (np.cos(wd * t) + alpha / wd * np.sin(wd * t)))
    return i, U_C


def so_sanh_task2(V0, R, L, C, n_points=3000):
    """So sanh Cach A (he bac 1 + Euler) va Cach B (bac 2 + sai phan trung tam)."""
    tA, iA, ttA = simulate_circuit(V0, R, L, C, n_points=n_points)
    tB, iB, ttB = simulate_rlc_bac2(V0, R, L, C, t_end=tA[-1], n_points=n_points)
    i_ex, vC_ex = nghiem_giai_tich_rlc(tA, V0, R, L, C)

   

    kq = {
        "t": tA, "iA": iA, "iB": iB, "i_ex": i_ex,
        "vCA": ttA["U_C"], "vCB": ttB["U_C"], "vC_ex": vC_ex,
        "i_ref": np.max(np.abs(i_ex)), "vC_ref": V0,
    }
    return kq


