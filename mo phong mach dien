import numpy as np
import matplotlib.pyplot as plt

#  TASK 1 + TASK 2: MACH RL va RLC

def simulate_circuit(V0, R, L, C=None, t_end=None, n_points=3000):
    if t_end is None:
        if C is None:
            t_end = 5 * (L / R)                      # ~5 tau
        else:
            alpha = R / (2 * L)
            omega0 = 1 / np.sqrt(L * C)
            t_end = 5 / alpha if alpha > 0 else 20 / omega0
    t = np.linspace(0, t_end, n_points)
    dt = t[1] - t[0]

    def e(tk):
        return V0  # nguon DC dong mach tai t = 0

    if C is None:
        i = np.zeros(n_points)
        i[0] = 0.0  

        for n in range(n_points - 1):
            
            i[n + 1] = i[n]*(1-R*dt/L) + e(t[n])*dt/L

        U_R = R * i
        U_L = V0 - U_R         

        thong_tin = {
            "loai_mach": "RL",
            "i_xac_lap": V0 / R,
            "U_R": U_R,
            "U_L": U_L,
            "U_C": None,
        }

    else:
        
        i = np.zeros(n_points)
        q = np.zeros(n_points)
        i[0] = 0.0  
        q[0] = 0.0  

        for n in range(n_points - 1):
            
            i[n + 1] = i[n] + dt * ((e(t[n]) - R * i[n] - q[n] / C) / L)
            q[n + 1] = q[n] + dt * i[n]

        U_R = R * i
        U_C = q / C
        U_L = V0 - U_R - U_C    

        thong_tin = {
            "loai_mach": "RLC",
            "U_R": U_R,
            "U_L": U_L,
            "U_C": U_C,
        }

    return t, i, thong_tin


def ve_dothi_dongdien(t, i, thong_tin):
