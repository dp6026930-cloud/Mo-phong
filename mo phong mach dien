# -*- coding: utf-8 -*-
"""
MO PHONG MACH DIEN 

- TASK 1: Mach RL   noi tiep:  V - R - L
- TASK 2: Mach RLC  noi tiep:  V - R - L - C
    * Cach A: lap he phuong trinh vi phan bac 1 (i, q) + Euler tien
    * Cach B: dao ham 2 ve -> phuong trinh vi phan bac 2 theo i + sai phan bac 2
    * So sanh A, B voi nghiem giai tich
- TASK 3: Mach buck don gian:  Nguon 220V - Khoa K - L - (C // Tai 5 ohm) + diode xa D1
- TASK 4: Giong Task 3 nhung tai la NGUON DONG 1 A (thay cho dien tro 5 ohm):
    * 4A: ho vong (cung duty nhu Task 3)
    * 4B: kin vong, dieu khien luong cap (vong dong trong + vong ap ngoai, PI)

Y TUONG SAI PHAN:
  di/dt ~ (i[n+1] - i[n]) / dt   =>   i[n+1] = i[n] + dt * f(i[n], ...)

  Task 1 (RL):   f = (V - R*i) / L
  Task 2 (RLC):  f = (V - R*i - q/C) / L,  dq/dt = i
  Task 3 (buck): L*diL/dt = vsw - vC
                 C*dvC/dt = iL - vC/Rtai
                 vsw = Vin - Ron*iL   (K dong)
                 vsw = -Vd            (K mo, diode dan, iL > 0)
                 vsw = vC             (K mo, iL = 0: che do dong gian doan)

Chuong trinh xuat ra:
  1) Do thi dong dien i(t)
  2) Do thi hieu dien the tren tung phan tu
"""

import numpy as np
import matplotlib.pyplot as plt

OUT_DIR = "/mnt/user-data/outputs"


# =====================================================================
#  TASK 1 + TASK 2: MACH RL va RLC
# =====================================================================
def simulate_circuit(V0, R, L, C=None, t_end=None, n_points=3000):
    """
    Mo phong mach RL (C=None) hoac RLC (C=gia tri) noi tiep voi nguon DC step

    Tra ve: t, i, thong_tin (dict chua ca cac mang hieu dien the V_R, V_L, V_C)
    """
    # ----- Xac dinh khoang thoi gian mo phong t_end -----
    if t_end is None:
        if C is None:
            t_end = 5 * (L / R)                      # ~5 tau
        else:
            alpha = R / (2 * L)
            omega0 = 1 / np.sqrt(L * C)
            t_end = 5 / alpha if alpha > 0 else 20 / omega0

    # ----- Tao truc thoi gian roi rac voi buoc dt co dinh -----
    t = np.linspace(0, t_end, n_points)
    dt = t[1] - t[0]

    def V_source(tk):
        return V0  # nguon DC dong mach tai t = 0

    if C is None:
        # ================= MACH RL =================
        i = np.zeros(n_points)
        i[0] = 0.0  # dieu kien dau: dong dien qua cuon cam bang 0

        for n in range(n_points - 1):
            di_dt_n = (V_source(t[n]) - R * i[n]) / L
            i[n + 1] = i[n] + dt * di_dt_n

        V_R = R * i
        V_L = V0 - V_R          # tu KVL: V = V_R + V_L

        tau = L / R
        thong_tin = {
            "loai_mach": "RL",
            "tau": tau,
            "i_xac_lap": V0 / R,
            "V_R": V_R,
            "V_L": V_L,
            "V_C": None,
        }

    else:
        # ================= MACH RLC =================
        i = np.zeros(n_points)
        q = np.zeros(n_points)
        i[0] = 0.0  # dong dien ban dau = 0
        q[0] = 0.0  # dien tich tren tu ban dau = 0

        for n in range(n_points - 1):
            di_dt_n = (V_source(t[n]) - R * i[n] - q[n] / C) / L
            dq_dt_n = i[n]

            i[n + 1] = i[n] + dt * di_dt_n
            q[n + 1] = q[n] + dt * dq_dt_n

        V_R = R * i
        V_C = q / C
        V_L = V0 - V_R - V_C    # tu KVL: V = V_R + V_L + V_C

        alpha = R / (2 * L)
        omega0 = 1 / np.sqrt(L * C)
        if alpha < omega0:
            che_do = "dao dong tat dan (underdamped)"
        elif np.isclose(alpha, omega0):
            che_do = "tat toi han (critically damped)"
        else:
            che_do = "qua tat (overdamped)"

        thong_tin = {
            "loai_mach": "RLC",
            "alpha": alpha,
            "omega0": omega0,
            "che_do": che_do,
            "V_R": V_R,
            "V_L": V_L,
            "V_C": V_C,
        }

    return t, i, thong_tin


