#  TASK 4: MACH BUCK VOI TAI LA NGUON DONG
# =====================================================================
def simulate_buck_nguon_dong(vong_kin=False, Vin=220.0, L=330e-6, C=47e-6,
                             I_tai=1.0, Ron=0.05, Vd=0.7, fsw=50e3,
                             Ton=0.52e-6, Vref=5.0,
                             Kpv=0.15, Kiv=90.0, Kpi=0.03,
                             Iref_max=3.0, d_max=0.2,
                             dt=10e-9, t_end=20e-3):
    """
    Buck (K - D1 - L - C) voi tai la nguon dong hang I_tai.
    Phuong trinh:   L*diL/dt = v_sw - vC
                    C*dvC/dt = iL - I_tai      (khong con dien tro tai)
    Nguon dong chi hut dong khi vC > 0 (khong the hut dong khi khong co ap).

    vong_kin = False : ho vong, do rong xung co dinh Ton (giong Task 3).
    vong_kin = True  : dieu khien luong cap, cap nhat 1 lan moi chu ky dong cat
        - Vong ap ngoai (PI):  i_ref = Kpv*(Vref - vC) + Iv,  Iv += Kiv*(Vref - vC)*T
        - Vong dong trong:     d = (vC + Vd)/Vin + Kpi*(i_ref - iL)
        (iL, vC lay gia tri trung binh cua chu ky truoc)
    """
    T = 1 / fsw
    buoc_T = round(T / dt)
    buoc_on = round(Ton / dt)
    N = int(t_end / dt)

    t = np.arange(N) * dt
    iL = np.zeros(N)
    vC = np.zeros(N)
    n_ck = N // buoc_T
    duty = np.zeros(n_ck + 1)
    i_ref_log = np.zeros(n_ck + 1)

    i, v = 0.0, 0.0
    Iv = 0.0
    tong_i = tong_v = 0.0
    if vong_kin:
        buoc_on = 0                     # chu ky dau tien: K mo
    for n in range(N):
        k = n % buoc_T
        if vong_kin and k == 0 and n > 0:
            i_tb, v_tb = tong_i / buoc_T, tong_v / buoc_T
            tong_i = tong_v = 0.0
            e_v = Vref - v_tb
            Iv = min(max(Iv + Kiv * e_v * T, 0.0), Iref_max)
            i_ref = min(max(Kpv * e_v + Iv, 0.0), Iref_max)
            d = (v_tb + Vd) / Vin + Kpi * (i_ref - i_tb)
            d = min(max(d, 0.0), d_max)
            buoc_on = int(round(d * buoc_T))
            duty[n // buoc_T] = d
            i_ref_log[n // buoc_T] = i_ref
        dong = k < buoc_on
        if dong:
            u = Vin - Ron * i
        elif i > 0:
            u = -Vd
        else:
            u = v
        I_hut = I_tai if v > 0 else 0.0
        i += dt * (u - v) / L
        v += dt * (i - I_hut) / C
        if (not dong) and i < 0:
            i = 0.0
        iL[n], vC[n] = i, v
        tong_i += i
        tong_v += v
    if not vong_kin:
        duty[:] = Ton / T

    ss = t > t_end - 2e-3
    z = t > t_end - 100e-6
    ngoai = np.where(np.abs(vC - Vref) > 0.02 * Vref)[0]
    t_xl = t[ngoai[-1]] * 1e3 if len(ngoai) else 0.0
    tt = {
        "vong_kin": vong_kin, "t_end": t_end, "Vref": Vref, "I_tai": I_tai,
        "Vout_tb": vC[ss].mean(), "Vout_min": vC[ss].min(), "Vout_max": vC[ss].max(),
        "IL_tb": iL[ss].mean(), "IL_min": iL[ss].min(), "IL_max": iL[ss].max(),
        "gonsong_V": vC[z].max() - vC[z].min(), "gonsong_I": iL[z].max() - iL[z].min(),
        "vot_lo": vC.max(), "t_xac_lap_ms": t_xl,
        "duty_tb": duty[n_ck // 2:n_ck].mean(),
    }
    return t, iL, vC, duty, i_ref_log, tt


