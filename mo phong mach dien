# =====================================================================
#  TASK 2 - CACH B: DAO HAM 2 VE + SAI PHAN BAC 2
# =====================================================================
def simulate_rlc_bac2(V0, R, L, C, t_end=None, n_points=3000):
    """
    Cach B. Xuat phat tu  L*di/dt + R*i + q/C = V0.
    Dao ham 2 ve theo t (dq/dt = i, V0 = const):
        L*i'' + R*i' + i/C = 0
    Sai phan bac 2 (sai phan trung tam):
        i''  ~ (i[n+1] - 2 i[n] + i[n-1]) / dt^2
        i'   ~ (i[n+1] - i[n-1]) / (2 dt)
    =>  i[n+1] = [ (2L/dt^2 - 1/C) i[n] - (L/dt^2 - R/(2dt)) i[n-1] ]
                 / (L/dt^2 + R/(2dt))
    Dieu kien dau (lay tu phuong trinh goc tai t = 0, q(0) = 0):
        i(0)  = 0
        i'(0) = V0 / L
        i''(0) = -(R*i'(0) + i(0)/C) / L = -R*V0/L^2
    Buoc dau tien i[1] tinh bang khai trien Taylor bac 2:
        i[1] = i[0] + dt*i'(0) + dt^2/2 * i''(0)
    Dien ap: V_R = R*i ; V_L = L*di/dt (sai phan trung tam) ; V_C = V0 - V_R - V_L
    """
    alpha = R / (2 * L)
    omega0 = 1 / np.sqrt(L * C)
    if t_end is None:
        t_end = 5 / alpha if alpha > 0 else 20 / omega0

    t = np.linspace(0, t_end, n_points)
    dt = t[1] - t[0]

    i = np.zeros(n_points)
    di0 = V0 / L
    d2i0 = -R * V0 / L**2
    i[0] = 0.0
    i[1] = i[0] + dt * di0 + 0.5 * dt**2 * d2i0

    a = L / dt**2
    b = R / (2 * dt)
    for n in range(1, n_points - 1):
        i[n + 1] = ((2 * a - 1 / C) * i[n] - (a - b) * i[n - 1]) / (a + b)

    # di/dt bang sai phan trung tam (2 dau dung gia tri da biet / sai phan lui)
    didt = np.zeros(n_points)
    didt[1:-1] = (i[2:] - i[:-2]) / (2 * dt)
    didt[0] = di0
    didt[-1] = (i[-1] - i[-2]) / dt

    V_R = R * i
    V_L = L * didt
    V_C = V0 - V_R - V_L
    return t, i, {"V_R": V_R, "V_L": V_L, "V_C": V_C, "dt": dt}


def nghiem_giai_tich_rlc(t, V0, R, L, C):
    """Nghiem chinh xac cua mach RLC underdamped (dung lam chuan so sanh)."""
    alpha = R / (2 * L)
    w0 = 1 / np.sqrt(L * C)
    wd = np.sqrt(w0**2 - alpha**2)
    i = V0 / (wd * L) * np.exp(-alpha * t) * np.sin(wd * t)
    V_C = V0 * (1 - np.exp(-alpha * t) * (np.cos(wd * t) + alpha / wd * np.sin(wd * t)))
    return i, V_C


def so_sanh_task2(V0, R, L, C, n_points=3000):
    """So sanh Cach A (he bac 1 + Euler) va Cach B (bac 2 + sai phan trung tam)."""
    tA, iA, ttA = simulate_circuit(V0, R, L, C, n_points=n_points)
    tB, iB, ttB = simulate_rlc_bac2(V0, R, L, C, t_end=tA[-1], n_points=n_points)
    i_ex, vC_ex = nghiem_giai_tich_rlc(tA, V0, R, L, C)

    def sai_so(x, x_ex):
        e = x - x_ex
        return {"max": np.max(np.abs(e)), "rmse": np.sqrt(np.mean(e**2))}

    kq = {
        "t": tA, "iA": iA, "iB": iB, "i_ex": i_ex,
        "vCA": ttA["V_C"], "vCB": ttB["V_C"], "vC_ex": vC_ex,
        "err_iA": sai_so(iA, i_ex), "err_iB": sai_so(iB, i_ex),
        "err_vCA": sai_so(ttA["V_C"], vC_ex), "err_vCB": sai_so(ttB["V_C"], vC_ex),
        "i_ref": np.max(np.abs(i_ex)), "vC_ref": V0,
    }
    return kq


def khao_sat_hoi_tu(V0, R, L, C, list_n=(500, 1000, 3000, 10000, 30000)):
    """Sai so max cua i(t) theo so diem: kiem tra bac chinh xac cua 2 cach."""
    ket_qua = []
    for n in list_n:
        kq = so_sanh_task2(V0, R, L, C, n_points=n)
        dt = kq["t"][1] - kq["t"][0]
        ket_qua.append((n, dt, kq["err_iA"]["max"], kq["err_iB"]["max"]))
    return ket_qua


