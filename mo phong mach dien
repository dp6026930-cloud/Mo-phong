    for a in ax:
        a.grid(True, alpha=0.3)
    fig.tight_layout()


def simulate_buck(Vin=220.0, L=330e-6, C=47e-6, R_tai=5.0,
                 fsw=50e3, Ton=0.455e-6,
                  dt=5e-9, t_end=10e-3):
    T = 1 / fsw
    N = int(t_end / dt)
    buoc_T = round(T / dt)
    buoc_on = round(Ton / dt)

    t = np.arange(N) * dt
    iL = np.zeros(N)
    vC = np.zeros(N)
    vsw = np.zeros(N)

    i, v = 0.0, 0.0
    for n in range(N):
        if (n % buoc_T) < buoc_on:           
            u = Vin 
        else:                                
            u = 0
        i += dt * (u - v) / L
        v += dt * (i - v / R_tai) / C
        iL[n], vC[n], vsw[n] = i, v, u

    ss = t > t_end - 2e-3
    ngoai = np.where(np.abs(vC - vC[ss].mean()) > 0.02 * vC[ss].mean())[0]
   
    thong_tin = {
        "loai_mach": "Buck SPDT",
        "Vout_tb": vC[ss].mean(),
        "vot_lo": vC.max(),
        "t_xac_lap_ms": t[ngoai[-1]] * 1e3 if len(ngoai) else 0.0,
        "t_end": t_end,
    }
    return t, iL, vC, vsw, thong_tin


def ve_buck(t, vC):
    fig, ax = plt.subplots(1, 1, figsize=(10, 11))
    ms = t * 1e3

    ax.plot(ms, vC, color="tab:blue")
    ax.axhline(5, color="r", ls="--", lw=0.8, label="5 V")
    ax.set_ylabel("Vout (V)")
    ax.set_title("Buck 220V -> 5V (khoa chuyen mach - L - C // Tai)")
    ax.legend()

    fig.tight_layout()




#  TASK 4: MACH BUCK VOI TAI LA NGUON DONG

def simulate_buck_nguon_dong(vong_kin=False, Vin=220.0, L=330e-6, C=47e-6,
                             I_tai=1.0, Ron=0.0, fsw=50e3,
                             Ton=0.455e-6, Vref=5.0,
                             Kpv=0.15, Kiv=90.0, Kpi=0.03,
                             Iref_max=3.0, d_max=0.2,
                             dt=5e-9, t_end=20e-3):

    T = 1 / fsw
    buoc_T = round(T / dt)
    buoc_on = round(Ton / dt)
    N = int(t_end / dt)

    t = np.arange(N) * dt
    iL = np.zeros(N)
    vC = np.zeros(N)
    n_ck = N // buoc_T
    duty = np.zeros(n_ck + 1)
    i_ref_log = np.zeros(n_ck + 1)

    i, v = 0.0, 0.0
    Iv = 0.0
    tong_i = tong_v = 0.0
    if vong_kin:
        buoc_on = 0                    
    for n in range(N):
        k = n % buoc_T
        if vong_kin and k == 0 and n > 0:
            i_tb, v_tb = tong_i / buoc_T, tong_v / buoc_T
            tong_i = tong_v = 0.0
            e_v = Vref - v_tb
            Iv = min(max(Iv + Kiv * e_v * T, 0.0), Iref_max)
            i_ref = min(max(Kpv * e_v + Iv, 0.0), Iref_max)
            d = v_tb/ Vin + Kpi * (i_ref - i_tb)
            d = min(max(d, 0.0), d_max)
            buoc_on = int(round(d * buoc_T))
            duty[n // buoc_T] = d
        if k < buoc_on:              
            u = Vin 
        else:                           
            u = 0.0
        I_hut = I_tai if v > 0 else 0.0
        i += dt * (u - v) / L
        v += dt * (i - I_hut) / C
        iL[n], vC[n] = i, v
        tong_i += i
        tong_v += v
    if not vong_kin:
        duty[:] = Ton / T

    ss = t > t_end - 2e-3
   
    tt = {
        "vong_kin": vong_kin, "t_end": t_end, "Vref": Vref, "I_tai": I_tai,
        "Vout_tb": vC[ss].mean(), "Vout_min": vC[ss].min(), "Vout_max": vC[ss].max(),
    }
    return t, vC, duty, tt


def ve_buck_nguon_dong(kq_ho, kq_kin):
   
    t, vC_h, _,tt_h = kq_ho
    _, vC_k,_, tt_k = kq_kin
    ms = t * 1e3
    fig, ax = plt.subplots(1, 1, figsize=(10, 10))

    ax.plot(ms, vC_h, color="tab:red", lw=1.0, label="4A: ho vong")
    ax.plot(ms, vC_k, color="tab:blue", lw=1.4, label="4B: kin vong")
    ax.axhline(5, color="k", ls="--", lw=0.8)
    ax.set_ylabel("Vout (V)")
    ax.set_title("Buck 220V -> 5V, khoa chuyen mach, tai la nguon dong 1 A")
    ax.legend(loc="lower right")

    fig.tight_layout()
    


