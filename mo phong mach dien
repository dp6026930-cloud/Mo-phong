        ax.axhline(thong_tin["i_xac_lap"], color="gray", ls="--", lw=1,
                   label=f"I_xac_lap = {thong_tin['i_xac_lap']:.2f} A")
        tieu_de = "Dòng điện mạch RL"
    else:
        ax.plot(t * 1000, i, color="tab:red", lw=1.8, label="i(t)")
        tieu_de = "Dòng điện mạch RLC"

    ax.set_xlabel("Thời gian t (ms)")
    ax.set_ylabel("Dòng điện i(t) (A)")
    ax.set_title(tieu_de)
    ax.grid(True, alpha=0.3)
    ax.legend()
    fig.tight_layout()
   


