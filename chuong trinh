import numpy as np
import matplotlib.pyplot as plt

# khai báo thông số
m = 2.0      # khối lượng vật
g = 9.81     # gia tốc trọng trường
u = 0.6      # hệ số ma sát trượt
k = 0.5      # hệ số lực cản không khí
x0 = 0.0
v0 = 0.0
t_max = 100.0
dt = 0.0001
#nhập hàm
print("Nhập định nghĩa lực F(t) theo biến t.")
print("- Nếu chỉ là 1 biểu thức đơn giản, gõ 1 dòng rồi Enter (VD: 50*sin(t)).")
print("- Nếu là hàm nhiều nhánh (if/elif/else, dùng 'return'), gõ nhiều dòng,")
print("  và nhập một dòng TRỐNG để kết thúc.")

_lines = []
while True:
    _line = input()
    if _line.strip() == "":
        break
    _lines.append(_line)

if len(_lines) == 0:
    raise SystemExit("Bạn chưa nhập gì cho F(t).")

# Nếu người dùng chỉ gõ 1 dòng và không dùng "return" -> hiểu là 1 biểu thức đơn
if len(_lines) == 1 and "return" not in _lines[0]:
    _body_lines = [f"return ({_lines[0]})"]
else:
    _body_lines = _lines

# Ghép thành mã nguồn của hàm _F_user(t), thụt lề 4 khoảng trắng cho mỗi dòng
_func_src = "def _F_user(t):\n" + "\n".join("    " + ln for ln in _body_lines)

# Không gian tên an toàn: cho phép các hàm numpy (sin, cos, exp, ...) dùng trực tiếp
_allowed_names = {name: getattr(np, name) for name in dir(np) if not name.startswith("_")}
_safe_globals = {"__builtins__": {}, **_allowed_names}
_safe_locals = {}

try:
    exec(compile(_func_src, "<F_input>", "exec"), _safe_globals, _safe_locals)
except SyntaxError as e:
    raise SystemExit(f"Cú pháp hàm F(t) không hợp lệ: {e}")

_F_user = _safe_locals["_F_user"]

def F(t):
    """Trả về lực tại thời điểm t; nếu hàm người dùng không return (rơi ngoài
    mọi nhánh if/elif), mặc định trả về 0 thay vì gây lỗi."""
    try:
        result = _F_user(t)
    except Exception as e:
        raise SystemExit(f"Lỗi khi tính F(t={t}): {e}")
    if result is None:
        return 0.0
    return float(result)

# Kiểm tra thử vài giá trị trước khi chạy mô phỏng dài
try:
    print(f"Kiểm tra: F(0) = {F(0.0)}")
except Exception as e:
    raise SystemExit(f"Không thể tính F(t) với hàm đã nhập: {e}")


# giải phương trình vi phân
N = int(t_max / dt)

t_list = np.linspace(0, t_max, N + 1)
x_list = np.zeros(N + 1)
v_list = np.zeros(N + 1)
a_list = np.zeros(N + 1)

x_list[0] = x0
v_list[0] = v0

for i in range(N):
    t_n = t_list[i]
    x_n = x_list[i]
    v_n = v_list[i]

    F_c = -k * v_n*abs(v_n)
    F_push = F(t_n)

    # Tính lực ma sát (cản trở chuyển động)
    if v_n > 0.0001:
        F_ms = -u * m * g
    elif v_n < -0.0001:
        F_ms = u * m * g
    else:
        if abs(F_push + F_c) <= u * m * g:
            F_ms = -(F_push + F_c)
        else:
            F_ms = -u * m * g if (F_push + F_c) > 0 else u * m * g

    # tổng lực và gia tốc
    F_total = F_push + F_c + F_ms
    a_n = F_total / m
    a_list[i] = a_n

    v_next = v_n + a_n * dt
    x_next = x_n + v_n * dt

    v_list[i + 1] = v_next
    x_list[i + 1] = x_next

a_list[-1] = a_list[-2]

# vẽ đồ thị
fig, (ax1, ax2, ax3) = plt.subplots(3, 1, figsize=(9, 9), sharex=True)

ax1.plot(t_list, x_list, color='blue', linewidth=1.5, label='Đồ thị x')
ax1.set_ylabel('x (m)')
ax1.grid(True)
ax1.legend(loc='upper left')

ax2.plot(t_list, v_list, color='red', linewidth=1.5, label='Đồ thị v')
ax2.set_ylabel('v (m/s)')
ax2.grid(True)
ax2.legend(loc='upper left')

ax3.plot(t_list, a_list, color='green', linewidth=1.5, label='Đồ thị a')
ax3.set_ylabel('a (m/s²)')
ax3.set_xlabel('Thời gian t (s)')
ax3.grid(True)
ax3.legend(loc='upper left')

plt.tight_layout()
plt.show()
